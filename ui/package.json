{
  "name": "@modufolio/media",
  "version": "0.3.0",
  "description": "Media-library UI for Appkit portfolio sites — album sidebar, media grid, inspectors, upload queue, and their composables (Vue 3 + Inertia).",
  "license": "MIT",
  "type": "module",
  "author": "Maarten Thiebou",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/index.css"
  },
  "peerDependencies": {
    "@inertiajs/vue3": "^3.0.0",
    "@modufolio/panel": "^0.8.0",
    "@vueuse/core": ">=10",
    "lodash": "^4.17.0",
    "vue": "^3.5.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "test": "vitest --run --config vitest.config.ts",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings 0"
  },
  "peerDependenciesMeta": {
    "lodash": {
      "optional": true
    }
  },
  "dependencies": {
    "blurhash": "^2.0.5",
    "plyr": "^3.8.4",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@inertiajs/vue3": "3.0.0",
    "@modufolio/panel": "^0.8.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^13.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.6.1",
    "lodash": "^4.17.21",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.0.18",
    "vue": "^3.5.18",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modufolio/media.git",
    "directory": "ui"
  },
  "homepage": "https://github.com/modufolio/media/tree/main/ui#readme",
  "bugs": "https://github.com/modufolio/media/issues",
  "keywords": [
    "vue",
    "inertia",
    "media-library",
    "photo",
    "album",
    "gallery",
    "upload",
    "tus"
  ],
  "publishConfig": {
    "access": "public"
  }
}
