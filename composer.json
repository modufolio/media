{
    "name": "modufolio/media",
    "description": "Album and media management for Appkit portfolio sites: nested-set albums, the media library, upload processing and the SQLite integrity triggers.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Maarten Thiebou"
        }
    ],
    "require": {
        "php": ">=8.3",
        "claviska/simpleimage": "^4.0",
        "doctrine/orm": "^3.0",
        "kornrunner/blurhash": "^1.2",
        "modufolio/appkit": "*",
        "ramsey/uuid": "^4.0",
        "ramsey/uuid-doctrine": "^2.0",
        "symfony/validator": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Modufolio\\Media\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Modufolio\\Media\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../appkit"
        }
    ]
}
